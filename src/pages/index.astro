---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';

const homeEntry = await getEntry('home', 'home');
if (!homeEntry) throw new Error('Missing src/content/home.mdx');
const { Content: HomeContent } = await render(homeEntry);

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => +b.data.updatedAt - +a.data.updatedAt)
  .slice(0, 3);
---

<BaseLayout
  title=""
  description={`${site.headline}。${site.status}`}
>
  <section class="surface-panel mb-14 rounded-[2rem] p-6 md:p-10">
    <div class="grid gap-8 md:grid-cols-[1.7fr_1fr] md:items-end">
      <div>
        <p class="eyebrow mb-3">
          {site.title}
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.05] mb-5 tracking-tight">
          {homeEntry.data.headline}
        </h1>
        <p class="text-base md:text-lg mb-5 max-w-2xl leading-8" style="color: var(--color-muted);">
          {homeEntry.data.intro}
        </p>
        <p class="status-pill mb-7">
          {site.status}
        </p>
        <div class="flex flex-wrap gap-3 mb-6">
          <a
            href="/resume"
            class="button-primary min-w-28"
            style="background: var(--color-accent); color: #ffffff;"
          >
            查看在线简历
          </a>
          <a
            href="/projects"
            class="button-secondary"
            style="color: var(--color-fg);"
          >
            查看作品集
          </a>
          <a
            href="/contact"
            class="button-secondary"
            style="color: var(--color-fg);"
          >
            联系我
          </a>
        </div>
        {
          homeEntry.data.techTags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5 list-none p-0">
              {homeEntry.data.techTags.map((t) => (
                <li class="tag">
                  {t}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <aside class="quiet-card rounded-3xl p-5">
        <p class="text-sm font-semibold mb-4" style="color: var(--color-fg);">
          给访问者的 30 秒速读
        </p>
        <dl class="grid gap-4 text-sm">
          <div>
            <dt class="mb-1" style="color: var(--color-subtle);">当前阶段</dt>
            <dd class="font-medium" style="color: var(--color-fg);">苏州大学人工智能硕士，2027 届</dd>
          </div>
          <div>
            <dt class="mb-1" style="color: var(--color-subtle);">重点方向</dt>
            <dd class="font-medium" style="color: var(--color-fg);">大模型应用 / Agent 工程</dd>
          </div>
          <div>
            <dt class="mb-1" style="color: var(--color-subtle);">证据入口</dt>
            <dd class="font-medium" style="color: var(--color-fg);">Demo、GitHub、架构图与复盘</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="mb-12 prose prose-neutral max-w-none">
    <HomeContent />
  </section>

  <section class="mb-4">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-2xl font-semibold tracking-tight">代表项目</h2>
      <a href="/projects" class="text-sm">全部 →</a>
    </div>
    <div class="grid gap-4">
      {
        featured.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            role={p.data.role}
            status={p.data.status}
            tags={p.data.tags}
            evidence={p.data.evidence}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
