---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('articles');
const published = all.filter((a) => a.data.status !== 'draft');

type ArticleEntry = (typeof published)[number];

const sections: Array<{
  id: 'playbook' | 'pitfalls' | 'notes';
  title: string;
}> = [
  { id: 'playbook', title: 'Playbook' },
  { id: 'pitfalls', title: '踩坑' },
  { id: 'notes', title: '手记与复盘' },
];

function byOrder(a: ArticleEntry, b: ArticleEntry): number {
  const ao = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const bo = b.data.order ?? Number.MAX_SAFE_INTEGER;
  if (ao !== bo) return ao - bo;
  return +b.data.publishedAt - +a.data.publishedAt;
}

const grouped = sections.map((section) => ({
  ...section,
  items: published.filter((a) => a.data.group === section.id).sort(byOrder),
}));
---

<BaseLayout title="技术文章" description="工程实践与踩坑复盘。">
  <header class="mb-6">
    <h1 class="text-3xl font-bold mb-2">技术文章</h1>
  </header>

  {
    published.length === 0 ? (
      <p style="color: var(--color-muted);">暂无已发布文章。</p>
    ) : (
      <div class="articles-tree">
        {grouped.map((section) =>
          section.items.length === 0 ? null : (
            <details class="articles-folder">
              <summary class="articles-folder-summary">
                <span class="articles-folder-chevron" aria-hidden="true" />
                <span class="articles-folder-name">{section.title}</span>
                <span class="articles-folder-count">{section.items.length}</span>
              </summary>
              <ul class="grid gap-4 list-none p-0 articles-folder-children">
                {section.items.map((a) => {
                  const isBroken = a.data.status === 'broken';
                  const dateLabel = a.data.publishedAt.toISOString().slice(0, 10);
                  const href = isBroken ? undefined : `/articles/${a.id}`;
                  return (
                    <li
                      class="rounded-lg border p-4"
                      style={`border-color: var(--color-border); background: var(--color-card); ${isBroken ? 'opacity: 0.6;' : ''}`}
                    >
                      <div class="flex items-baseline justify-between gap-3 mb-1">
                        <a
                          href={href}
                          class="font-semibold no-underline"
                          style="color: var(--color-fg);"
                        >
                          {a.data.title}
                          {isBroken && (
                            <span class="text-xs ml-2" style="color: var(--color-muted);">
                              [失效]
                            </span>
                          )}
                        </a>
                        <span class="text-xs shrink-0" style="color: var(--color-muted);">
                          {dateLabel}
                        </span>
                      </div>
                      <p class="text-sm mb-2" style="color: var(--color-muted);">
                        {a.data.summary}
                      </p>
                      {a.data.tags.length > 0 && (
                        <ul class="flex flex-wrap gap-1.5 list-none p-0">
                          {a.data.tags.map((t) => (
                            <li
                              class="text-xs px-2 py-0.5 rounded"
                              style="border: 1px solid var(--color-border); color: var(--color-muted);"
                            >
                              {t}
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            </details>
          )
        )}
      </div>
    )
  }
</BaseLayout>
