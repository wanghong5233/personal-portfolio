---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const updatedLabel = entry.data.updatedAt.toISOString().slice(0, 10);

const statusLabel: Record<string, string> = {
  live: '已部署',
  listed: '已上架',
  demo: 'MVP 开放',
  wip: '持续迭代',
  archived: '归档',
};

const videoHref = entry.data.evidence.video?.trim();
const isExternalVideo = Boolean(videoHref && /^https?:\/\//.test(videoHref));
const localVideoPublicPath =
  videoHref && videoHref.startsWith('/') ? join(process.cwd(), 'public', videoHref.slice(1)) : undefined;
const hasLocalVideo = Boolean(localVideoPublicPath && existsSync(localVideoPublicPath));
const canPlayVideo = Boolean(videoHref) && (isExternalVideo || hasLocalVideo);
const missingVideoHint =
  videoHref && videoHref.startsWith('/')
    ? `请将视频文件放到 public${videoHref}，或改成可访问的外链 URL。`
    : '请确认视频 URL 可访问。';
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="prose prose-neutral max-w-none">
    <header class="not-prose mb-6">
      <p class="text-sm mb-1" style="color: var(--color-muted);">
        {entry.data.role}
      </p>
      <h1 class="text-3xl font-bold mb-2">{entry.data.title}</h1>
      <p class="text-base mb-3" style="color: var(--color-muted);">
        {entry.data.summary}
      </p>
      <div class="flex flex-wrap items-center gap-2 text-xs mb-4" style="color: var(--color-muted);">
        <span
          class="rounded-full px-2 py-0.5"
          style="border: 1px solid var(--color-border);"
        >
          {statusLabel[entry.data.status] ?? entry.data.status}
        </span>
        <span>更新：{updatedLabel}</span>
      </div>
      {
        entry.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5 list-none p-0 mb-3">
            {entry.data.tags.map((t) => (
              <li
                class="text-xs px-2 py-0.5 rounded"
                style="border: 1px solid var(--color-border); color: var(--color-muted);"
              >
                {t}
              </li>
            ))}
          </ul>
        )
      }
      {
        entry.data.stack.length > 0 && (
          <p class="text-sm" style="color: var(--color-muted);">
            技术栈：{entry.data.stack.join(' · ')}
          </p>
        )
      }
      <div class="mt-3">
        <EvidenceLinks evidence={entry.data.evidence} />
      </div>
    </header>

    {
      videoHref && (
        <section
          class="not-prose mb-6 rounded-2xl border p-4"
          style="border-color: var(--color-border); background: var(--color-card);"
        >
          <h2 class="text-base font-semibold mb-3" style="color: var(--color-fg);">演示视频</h2>
          {
            canPlayVideo ? (
              <video
                class="w-full rounded-lg"
                style="border: 1px solid var(--color-border); background: #000;"
                controls
                preload="metadata"
                playsinline
              >
                <source src={videoHref} type="video/mp4" />
                当前浏览器不支持 HTML5 视频播放。请直接打开
                <a href={videoHref} style="margin-left: 0.25rem;">视频链接</a>。
              </video>
            ) : (
              <p class="text-sm" style="color: var(--color-muted);">{missingVideoHint}</p>
            )
          }
        </section>
      )
    }

    <Content />
  </article>

  <p class="mt-10 text-sm">
    <a href="/projects">← 返回作品集</a>
  </p>
</BaseLayout>
