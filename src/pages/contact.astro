---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
---

<BaseLayout title="联系方式" description="邮箱、GitHub 与可联系状态。">
  <header class="mb-6">
    <h1 class="text-3xl font-bold mb-2">联系方式</h1>
    <p class="text-sm" style="color: var(--color-muted);">
      偏好顺序：{contact.preferredContact}。<br />
      {contact.availability}
    </p>
  </header>

  <section class="grid gap-4 mb-8">
    <div
      class="rounded-lg border p-4"
      style="border-color: var(--color-border); background: var(--color-card);"
    >
      <p class="text-xs mb-1" style="color: var(--color-muted);">邮箱（推荐）</p>
      <div class="flex flex-wrap items-center gap-2">
        <a href={`mailto:${contact.email}`} class="font-mono">
          {contact.email}
        </a>
        <button
          type="button"
          id="copy-email"
          class="text-xs rounded px-2 py-1"
          style="border: 1px solid var(--color-border); color: var(--color-fg); background: transparent;"
        >
          复制邮箱
        </button>
      </div>
    </div>

    <div
      class="rounded-lg border p-4"
      style="border-color: var(--color-border); background: var(--color-card);"
    >
      <p class="text-xs mb-1" style="color: var(--color-muted);">GitHub</p>
      <a href={contact.github} target="_blank" rel="noopener" class="font-mono">{contact.github}</a>
    </div>

    {contact.feishu && (
      <div
        class="rounded-lg border p-4"
        style="border-color: var(--color-border); background: var(--color-card);"
      >
        <p class="text-xs mb-1" style="color: var(--color-muted);">飞书主页</p>
        <a href={contact.feishu} target="_blank" rel="noopener" class="font-mono">{contact.feishu}</a>
      </div>
    )}

    {contact.blog && (
      <div
        class="rounded-lg border p-4"
        style="border-color: var(--color-border); background: var(--color-card);"
      >
        <p class="text-xs mb-1" style="color: var(--color-muted);">技术博客</p>
        <a href={contact.blog} target="_blank" rel="noopener" class="font-mono">{contact.blog}</a>
      </div>
    )}

    {contact.wechatQr && (
      <div
        class="rounded-lg border p-4"
        style="border-color: var(--color-border); background: var(--color-card);"
      >
        <p class="text-xs mb-2" style="color: var(--color-muted);">微信</p>
        <p class="text-sm mb-3" style="color: var(--color-muted);">
          微信号不公开展示。请通过下方二维码添加，备注来源以便确认。
        </p>
        <details>
          <summary class="text-sm cursor-pointer">展开二维码</summary>
          <div class="mt-3">
            <img
              src={contact.wechatQr}
              alt="微信二维码"
              width="200"
              height="200"
              loading="lazy"
              style="border: 1px solid var(--color-border); border-radius: 6px;"
            />
          </div>
        </details>
      </div>
    )}
  </section>

</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof HTMLElement && target.id === 'copy-email') {
      const email = target.previousElementSibling?.textContent?.trim();
      if (!email) return;
      navigator.clipboard.writeText(email).then(() => {
        const original = target.textContent;
        target.textContent = '已复制';
        setTimeout(() => {
          target.textContent = original;
        }, 1500);
      });
    }
  });
</script>
