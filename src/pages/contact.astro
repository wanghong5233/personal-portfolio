---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
---

<BaseLayout title="联系方式" description="通过邮箱联系王鸿。">
  <header class="mb-6">
    <h1 class="text-3xl font-bold">联系方式</h1>
  </header>

  <section class="mb-8">
    <div
      class="rounded-lg border p-4"
      style="border-color: var(--color-border); background: var(--color-card);"
    >
      <p class="text-xs mb-1" style="color: var(--color-muted);">邮箱</p>
      <div class="flex flex-wrap items-center gap-2">
        <a href={`mailto:${contact.email}`} class="font-mono">
          {contact.email}
        </a>
        <button
          type="button"
          id="copy-email"
          class="text-xs rounded px-2 py-1"
          style="border: 1px solid var(--color-border); color: var(--color-fg); background: transparent;"
        >
          复制邮箱
        </button>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof HTMLElement && target.id === 'copy-email') {
      const email = target.previousElementSibling?.textContent?.trim();
      if (!email) return;
      navigator.clipboard.writeText(email).then(() => {
        const original = target.textContent;
        target.textContent = '已复制';
        setTimeout(() => {
          target.textContent = original;
        }, 1500);
      });
    }
  });
</script>
