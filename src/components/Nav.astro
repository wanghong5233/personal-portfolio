---
import site from '../data/site.json';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="no-print sticky top-0 z-30 backdrop-blur border-b"
  style="background: color-mix(in oklab, var(--color-surface) 88%, transparent); border-color: var(--color-border);"
>
  <div class="mx-auto max-w-5xl px-5 py-3.5 md:px-8 flex items-center gap-4">
    <a
      href="/"
      class="rounded-full px-2.5 py-1 text-sm font-semibold no-underline"
      style="border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-fg);"
    >
      {site.name}
    </a>
    <nav class="ml-auto flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {
        site.nav.map((item) => {
          const isExternal = item.href.startsWith('http');
          const isActive = !isExternal && (
            item.href === '/'
              ? pathname === '/'
              : pathname === item.href || pathname.startsWith(item.href + '/')
          );
          return (
            <a
              href={item.href}
              class={`nav-link ${isActive ? 'nav-link-active font-semibold' : ''}`}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
