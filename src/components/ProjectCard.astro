---
import EvidenceLinks from './EvidenceLinks.astro';

type Status = 'live' | 'demo' | 'wip' | 'archived';

interface Props {
  href: string;
  title: string;
  summary: string;
  role: string;
  status: Status;
  tags: string[];
  evidence?: {
    demo?: string;
    github?: string;
    video?: string;
    architecture?: string;
    article?: string;
  };
}

const { href, title, summary, role, status, tags, evidence = {} } = Astro.props;

const statusLabel: Record<Status, string> = {
  live: '已上线',
  demo: 'Demo 可用',
  wip: '开发中',
  archived: '归档',
};
---

<article
  class="block rounded-lg border p-5 transition-colors"
  style="border-color: var(--color-border); background: var(--color-card);"
>
  <header class="flex items-baseline gap-3 mb-2">
    <a href={href} class="text-lg font-semibold no-underline" style="color: var(--color-fg);">
      {title}
    </a>
    <span
      class="text-xs rounded-full px-2 py-0.5"
      style="border: 1px solid var(--color-border); color: var(--color-muted);"
    >
      {statusLabel[status]}
    </span>
  </header>
  <p class="text-sm mb-3" style="color: var(--color-muted);">{summary}</p>
  <p class="text-xs mb-3" style="color: var(--color-subtle);">{role}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 mb-3 list-none p-0">
        {tags.map((t) => (
          <li
            class="text-xs px-2 py-0.5 rounded"
            style="border: 1px solid var(--color-border); color: var(--color-muted);"
          >
            {t}
          </li>
        ))}
      </ul>
    )
  }
  <div class="flex items-center justify-between gap-3">
    <EvidenceLinks evidence={evidence} compact />
    <a href={href} class="text-sm">查看详情 →</a>
  </div>
</article>
