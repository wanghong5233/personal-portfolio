---
import site from '../data/site.json';
import contact from '../data/contact.json';

const year = new Date().getFullYear();
---

<footer
  class="no-print mt-16 border-t"
  style="border-color: var(--color-border);"
>
  <div
    class="mx-auto max-w-5xl px-5 py-8 md:px-8 flex flex-col gap-3 text-sm"
    style="color: var(--color-muted);"
  >
    <div class="flex flex-wrap gap-x-4 gap-y-1">
      <a href={`mailto:${contact.email}`}>邮箱</a>
      <a href={contact.github} target="_blank" rel="noopener">GitHub</a>
      {contact.feishu && (
        <a href={contact.feishu} target="_blank" rel="noopener">飞书</a>
      )}
      {contact.blog && (
        <a href={contact.blog} target="_blank" rel="noopener">技术博客</a>
      )}
      <a href="/contact">联系方式</a>
      <a href="/resume">在线简历</a>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
      <span>© {year} {site.name}</span>
      <span>最后更新：{site.updatedAt}</span>
      <span>{site.domain.replace(/^https?:\/\//, '')}</span>
    </div>
  </div>
</footer>
