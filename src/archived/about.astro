---
/**
 * 【逻辑删除】关于页 — 不对外路由、不进导航
 *
 * 原因：
 * - 版式 / 区块结构（hero → 正文 → 怎么做事 → 时间线 → 私人）已定，保留实现
 * - 文案未定稿，对外展示会减分，因此从「在用」改为「归档」
 *
 * 当前状态：
 * - 本文件在 `src/archived/`，不参与 Astro 页面路由（原路径 `src/pages/about.astro`）
 * - `site.json` 的 `nav` 已去掉「关于」；恢复项见同文件 `navArchived`
 * - 数据仍在：`src/data/about.json`、`src/content/about.mdx`；样式仍在 `global.css`（`.about-*`）
 *
 * 恢复上线：
 * 1. 把本文件移回 `src/pages/about.astro`
 * 2. 删掉本注释块中「逻辑删除」说明（或改成「已上线」）
 * 3. 将 `site.json` 的 `navArchived` 里「关于」一项移回 `nav`
 * 4. 定稿后再发：改 `about.json` / `about.mdx`，不要带着半成品文案上线
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutData from '../data/about.json';

const entry = await getEntry('about', 'about');
if (!entry) throw new Error('Missing src/content/about.mdx');
const { Content } = await render(entry);
---

<BaseLayout title="关于" description={entry.data.summary}>
  <article class="about-page">
    <header class="about-hero">
      <p class="eyebrow mb-4">关于</p>
      <h1 class="about-statement">{aboutData.statement}</h1>
      {aboutData.lead && <p class="about-lead">{aboutData.lead}</p>}
    </header>

    <section class="about-block prose prose-neutral max-w-none">
      <Content />
    </section>

    <section class="about-block" aria-labelledby="about-principles">
      <h2 id="about-principles" class="about-label">怎么做事</h2>
      <ul class="about-items">
        {
          aboutData.principles.map((item) => (
            <li class="about-item">
              <span class="about-item-mark" aria-hidden="true">—</span>
              <div>
                <h3 class="about-item-title">{item.title}</h3>
                {item.body && <p class="about-item-body">{item.body}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-block" aria-labelledby="about-timeline">
      <h2 id="about-timeline" class="about-label">怎么走到这里</h2>
      <ol class="about-timeline">
        {
          aboutData.timeline.map((item) => (
            <li class="about-timeline-row">
              <span class="about-timeline-year">{item.year}</span>
              <p class="about-timeline-body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-block" aria-labelledby="about-personal">
      <h2 id="about-personal" class="about-label">一点私人的</h2>
      <ul class="about-personal">
        {aboutData.personal.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
